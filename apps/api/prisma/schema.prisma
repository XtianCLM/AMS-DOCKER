model CreditWithdrawalRequest {
  id                   String   @id @default(uuid())

  agentId              String
  agent                Agent    @relation(fields: [agentId],references: [id],onDelete: Cascade)

  purpose              PayoutPurpose @default(WITHDRAWAL)

  receiptImg     String?

  commissionScanId String?
  commissionScan   CommissionScan? @relation(fields: [commissionScanId],references: [id],onDelete: SetNull)

  commissionTransactionId String?
  commissionTransaction   CommissionTransaction? @relation(fields: [commissionTransactionId],references: [id],onDelete: SetNull)

  amount               Decimal  @db.Decimal(12, 2)
  payoutChannel        PayoutChannel @default(CHECK)

  accountName          String
  accountNumber        String?

  status               WithdrawalStatus @default(PENDING)

  xenditExternalId     String? @unique
  xenditDisbursementId String?

  failureCode          String?
  failureMessage       String?

  rawResponse          Json?
  rawWebhook           Json?

  requestedAt          DateTime @default(now())
  approvedBy           Int?
  approvedAt           DateTime?
  completedAt          DateTime?

  remarks              String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([agentId, status])
  @@index([commissionScanId])
}

model AgentWithdrawalLedger {
  id String @id @default(uuid())
  agentId String
  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  type CreditLedgerType
  amount Decimal @db.Decimal(12, 2)

  sourceType CreditSource
  sourceId String?

  description String?
  createdAt DateTime @default(now())
}

model AgentReactivationApproval {
  id String @id @default(uuid())

  requestId String
  request   AgentReactivationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  reviewerType ReactivationReviewerType

  reviewerUserId Int?
  reviewerUser   User? @relation("UserReactivationApprovals", fields: [reviewerUserId], references: [id])

  reviewerAgentId String?
  reviewerAgent   Agent? @relation("AgentReactivationApprovals", fields: [reviewerAgentId], references: [id])

  status ReactivationApprovalStatus @default(PENDING)

  approvalOrder Int @default(1)
  isRequired    Boolean @default(true)

  assignedAt DateTime @default(now())
  reviewedAt DateTime?

  remarks String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([requestId, reviewerType])
  @@index([requestId])
  @@index([reviewerType])
  @@index([status])
  @@index([reviewerUserId])
  @@index([reviewerAgentId])

  @@map("agent_reactivation_approvals")
}

model AgentReactivationAttachment {
  id String @id @default(uuid())

  requestId String
  request   AgentReactivationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  fileName String
  filePath String
  fileType String
  fileSize Int

  uploadedAt DateTime @default(now())

  @@index([requestId])

  @@map("agent_reactivation_attachments")
}

model AgentReassignmentLog {
  id              String   @id @default(uuid())

  droppedAgentId  String
  oldUplineId     String?
  newUplineId     String
  downlineAgentId String

  reassignedById  Int
  reason          String?

  createdAt       DateTime @default(now())

  @@index([droppedAgentId])
  @@index([oldUplineId])
  @@index([newUplineId])
  @@index([downlineAgentId])
  @@map("agent_reassignment_logs")
}

model AgentNotification {

  id            String   @id @default(uuid())

  agentId       String

  agent         Agent @relation(fields: [agentId],references: [id],onDelete: Cascade)

  type          NotificationType

  actionType  NotificationActionType?
  actionResult  ActionResult?
  entityId    String?

  title         String

  message       String

  isRead        Boolean @default(false)

  createdAt     DateTime @default(now())

  @@index([agentId])

  @@map("agent_notifications")
}


model AgentBranch {
  id            String    @id @default(uuid())

  agentId       String

  branchId      String


  agent         Agent @relation(fields: [agentId],references: [id],   onDelete: Cascade)

  branch        Branch @relation(fields: [branchId],references: [branchCode])


  isActive      Boolean  @default(true)

  assignedAt    DateTime @default(now())


  createdAt     DateTime @default(now())

  updatedAt     DateTime @updatedAt


  @@unique([agentId, branchId])

  @@index([agentId])

  @@index([branchId])

  @@map("agent_branches")
}

enum FormulaType {
  FORMULA2
  FORMULA3
  FORMULA4
}

model OverrideCommissionRule {
  id String @id @default(uuid())

  receiverLevel AgentLevel

  sourceLevel AgentLevel

  amount Decimal @db.Decimal(10,2)

  isActive Boolean @default(true)
  
  commissionTransactions CommissionTransaction[]

  createdById Int?

  createdBy User? @relation("CommissionRuleCreator",fields: [createdById],references: [id])


  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


model CommissionRule {
  id              String @id @default(uuid())


  accountType     String @default("CODED")

  agentStatus     AgentStatus

  formulaType     FormulaType


  sspAmount       Decimal @db.Decimal(12,2)

  piraRate        Int


  isActive        Boolean @default(true)

  createdAt       DateTime @default(now())

  updatedAt       DateTime @updatedAt


  commissionTransactions CommissionTransaction[]


  @@index([accountType])

  @@index([agentStatus])

  @@index([isActive])

  @@unique([accountType, agentStatus])

  @@map("commission_rules")
}


model DailyClientDetails {
  id             String   @id @default(uuid())
  secId          Int      @default(autoincrement())

  sourceClientId Int?
  in_date        DateTime?
  createdAt      DateTime @default(now())

  clientName     String
  loanAmount     Decimal? @db.Decimal(10,2)
  term           Int      @default(0)
  clientStatus   ClientStatus

  uploadedById Int?
  uploadedBy User? @relation(fields: [uploadedById], references: [id])

  commissionScans CommissionScan[]

  @@unique([sourceClientId,uploadedById])

  @@index([uploadedById])
}



model CommissionScan {
  id String @id @default(uuid())

  clientId String @unique

  saleReference String?

  client DailyClientDetails@relation(fields: [clientId], references: [id])

  claimedByAgentId String

  agent Agent@relation("ClaimedByAgent",fields: [claimedByAgentId], references: [id])

  branchId String

  AgentScannedStatus AgentStatus

  branch Branch@relation(fields: [branchId], references: [branchCode])

  scannedBy Int?

  scanner User?@relation("ProcessedCommissionScan",fields: [scannedBy], references: [id])

  scannedAt DateTime @default(now())

  createdAt DateTime @default(now())

  payoutChannel   PayoutChannel @default(CHECK)

  checkNumber String?

  commissionTransactions CommissionTransaction[]

  payoutRequests CreditWithdrawalRequest[]

  @@index([clientId])
  @@index([claimedByAgentId])
  @@index([branchId])

  @@map("commission_scans")
}

model CommissionTransaction {
  id                  String   @id @default(uuid())


  sourceAgentId       String

  sourceAgent         Agent @relation("SourceAgent",fields: [sourceAgentId],references: [id],  onDelete: Restrict)

  receiverAgentId     String

  receiverAgent       Agent @relation("ReceiverAgent",fields: [receiverAgentId],references: [id], onDelete: Restrict)

    // DIRECT RULE
  commissionRuleId String?

  commissionRule CommissionRule?@relation(fields: [commissionRuleId],references: [id])

  // OVERRIDE RULE
  overrideCommissionRuleId String?

  overrideCommissionRule OverrideCommissionRule?@relation(fields: [overrideCommissionRuleId],references: [id])


  commissionScanId String

  commissionScan CommissionScan @relation(fields: [commissionScanId],references: [id])

  commissionType      CommissionType

  payoutRequests CreditWithdrawalRequest[]


  saleAmount          Decimal @db.Decimal(12,2)


  commissionAmount    Decimal @db.Decimal(12,2)

  percentage          Decimal? @db.Decimal(5,2)

  sourceLevel         CommissionSourceLevel

  receiverLevel       AgentLevel @default(L1)

  remarks             String? @db.VarChar(255)


  createdAt           DateTime @default(now())


  @@index([sourceAgentId])

  @@index([receiverAgentId])

  @@index([commissionRuleId])

  @@index([createdAt])

  @@map("commission_transactions")
}

model ConvenienceFee {
  id String @id @default(uuid())

  type CompanyExpenseType
  sourceType CompanyExpenseSource
  sourceId String?

  amount Decimal @db.Decimal(12, 2)
  rate Decimal? @db.Decimal(5, 4)

  description String?

  createdBy Int?
  user User? @relation(fields: [createdBy], references: [id])

  rawData Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([sourceType])
  @@index([sourceId])
  @@index([createdAt])
}

model CompanyExpenseLog {
  id String @id @default(uuid())

  type CompanyExpenseType
  sourceType CompanyExpenseSource
  sourceId String?

  amount Decimal @db.Decimal(12, 2)
  rate Decimal? @db.Decimal(5, 4)

  description String?

  createdBy Int?
  user User? @relation(fields: [createdBy], references: [id])

  rawData Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([sourceType])
  @@index([sourceId])
  @@index([createdAt])
}
