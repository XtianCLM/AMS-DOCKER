// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

model User{
  id Int @id @default(autoincrement())
  email String? @unique
  name    String
  username String @unique @db.VarChar(100)
  password String 

  isActive  Boolean   @default(true)

  createdAt   DateTime    @default(now())
  updateAt    DateTime?    @updatedAt

  roles        UserRole[]
  
  agentId String? @unique

  branchId String?
  branch Branch? @relation(fields: [branchId], references: [branchCode])

  agent Agent? @relation(fields: [agentId], references: [id])

  companyExpenseLog CompanyExpenseLog[]

  convenienceFee ConvenienceFee[]

  reactivationRequests AgentReactivationRequest[]

  dailyClientUploads DailyClientDetails[]

  agentRecoPromotion AgentRecomForPromotion[]

  processedCommissionScans CommissionScan[]@relation("ProcessedCommissionScan")

  commissionRulesCreated OverrideCommissionRule[]@relation("CommissionRuleCreator")

  reactivationApprovals AgentReactivationApproval[] @relation("UserReactivationApprovals")

  @@map("user")
}


model Role {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  description  String?

  users   UserRole[]
  permissions  RolePermission[]
}

model UserRole {
  userId    Int
  roleId   Int


  user    User @relation(fields: [userId], references: [id])
  role    Role  @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
}


model Permission {
  id   Int    @id @default(autoincrement())
  code String @unique
  name String

  roles RolePermission[]
}

model RolePermission {
  roleId       Int
  permissionId Int

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
}

enum ClientStatus {
    NEW
    PENDING
    SCANNED
}



enum AgentStatus {
  PENDING
  REJECTED
  ACTIVE
  PROBATION
  EXPIRED
  DROPPED
  SUSPENDED
}

// enum AccType {
//   CODED
// }

enum AgentLevel {
  L1
  L2
  L3
}

enum CommissionSourceLevel {
  L1
  L2
  L3
}

enum CommissionType {
  DIRECT
  DOWNLINE
  WITHDRAW
}
enum MaintenanceStatus {
  GRACE
  ACTIVE
  COMPLETED
  EXPIRED
}

enum ReactivationRequestStatus {
  PENDING
  APPROVED_WAITING_PAYMENT
  APPROVED_WAITING_CONFIRMATION
  PAYMENT_PENDING
  PROBATION
  COMPLETED
  FAILED
  CANCELLED
}

enum RecoPromotionStatus {
  PENDING
  ACCEPTED
  PROMOTED
  REJECTED
}

enum ReactivationPaymentStatus {
  PENDING
  PAID
  EXPIRED
  FAILED
  CANCELLED
}


enum WithdrawalStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REJECTED
}

enum ReactivationType {
  SELF_REACTIVATION
  ADMIN_APPROVAL
}
enum ReactivationReviewerType {
  ADMIN
  UPLINE_AGENT
}

enum ReactivationApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}
enum NotificationType {
  MAINTENANCE_APPROVED
  MAINTENANCE_REJECTED
  MAINTENANCE_CREATED
  MAINTENANCE_WARNING
  MAINTENANCE_EXPIRED
  MAINTENANCE_DROPPED
  MAINTENANCE_SUSPENDED
  MAINTENANCE_COMPLETED
  MAINTENANCE_REACTIVATE
  MAINTENANCE_PROBATION
  MAINTENANCE_REASSIGN
  REACTIVATION_PAYMENT
  REACTIVATION_REQUEST
  AGENT_REGISTRATION
  AGENT_REASSIGNMENT

}

enum NotificationActionType {
  PROCEED_PAYMENT
  CONFIRMED_PAYMENT
  CONFIRMED_WITHDRAWAL
  AGENT_REASSIGNMENT
}

enum ActionResult {
  PAYMENT_PENDING
  PAYMENT_COMPLETED
  WITHDRAWAL_COMPLETED
  WITHDRAWAL_NOT_CONFIRM
}

enum CreditLedgerType {
  CREDIT
  DEBIT
  RESERVE
  RELEASE
}

enum CreditSource {
  COMMISSION
  WITHDRAWAL
}
enum PayoutPurpose {
  WITHDRAWAL
  DIRECT_COMMISSION
}

enum CompanyExpenseType {
  XENDIT_PAYOUT_FEE
  XENDIT_PAYMENT_FEE
}

enum CompanyExpenseSource {
  WITHDRAWAL
  REACTIVATION_PAYMENT
}

enum PayoutChannel {
  GCASH
  CHECK
}

model Company {
  companyCode    String    @id @db.VarChar(20)

  companyName    String?   @db.VarChar(100)

  branches       Branch[]

  createdAt      DateTime  @default(now())

  updatedAt      DateTime  @updatedAt

  deletedAt      DateTime?

  @@map("companydetails")
}



model Branch {
  branchCode     String    @id @db.VarChar(20)

  companyName    String?   @db.VarChar(50)

  location       String?   @db.VarChar(100)

  employeesCount String?   @db.VarChar(10)

  branchImage    String?   @db.VarChar(255)

  position       Int       @default(0)

  companyId      String?   @db.VarChar(20)

  company         Company? @relation(fields: [companyId],references: [companyCode])

  agents         AgentBranch[]

  users User[]

  commissionScans CommissionScan[]

  reactivationRequests AgentReactivationRequest[]

  createdAt      DateTime  @default(now())

  updatedAt      DateTime  @updatedAt

  deletedAt      DateTime?

  @@index([companyId])

  @@map("branches")
}

model Agent {

  id                 String   @id @default(uuid())

  profilePicture     String?

  agentCode          String   @unique @db.VarChar(100)

  username           String   @unique @db.VarChar(100)

  fullName           String   @db.VarChar(100)

  gender             String?  @db.VarChar(20)

  birthDate          DateTime?

  address            String?  @db.VarChar(255)

  email              String?  @db.VarChar(100)

  telephone          String?  @db.VarChar(20)

  SecondaryTel       String?  @db.VarChar(20)

  creditScore        Int      @default(0)

  consecutiveMonthsActive Int @default(0)

  status             AgentStatus

  accountType        String? @default("CODED")

  level              AgentLevel

  mustChangePassword Boolean  @default(true)

  parentAgentId      String?

  parentAgent        Agent?@relation("AgentHierarchy",fields: [parentAgentId],references: [id],onDelete: SetNull)

  downlines          Agent[]@relation("AgentHierarchy")

  branches           AgentBranch[]

  user User?

  reactivationPayments AgentReactivationPayment[]

  commissionScans CommissionScan[]@relation("ClaimedByAgent")

  commissionsEarned  CommissionTransaction[]@relation("ReceiverAgent")

  commissionsSource  CommissionTransaction[]@relation("SourceAgent")

  maintenanceCycles  AgentMaintenanceCycle[]

  reactivationRequests AgentReactivationRequest[]

  creditWithdrawalRequests CreditWithdrawalRequest[]

  agentWithdrawalLedger AgentWithdrawalLedger[]

  agentRecoPromotion AgentRecomForPromotion[]

  reactivationApprovals AgentReactivationApproval[] @relation("AgentReactivationApprovals")

  notifications      AgentNotification[]

  createdAt          DateTime @default(now())

  updatedAt          DateTime @updatedAt

  deletedAt          DateTime?

  @@index([parentAgentId])

  @@index([level])

  @@index([status])

  @@map("agents")
}


model AgentMaintenanceCycle {

  id                String @id @default(uuid())

  agentId           String

  agent             Agent@relation(fields: [agentId],references: [id],onDelete: Cascade)

  cycleMonth        Int

  cycleYear         Int

  cycleStartDate    DateTime

  cycleEndDate      DateTime

  requiredSales     Int @default(1)

  completedSales    Int @default(0)

  remainingSales    Int @default(1)

  isCompleted       Boolean @default(false)

  isFirstCycle      Boolean @default(false)

  completedAt       DateTime?

  expiredAt         DateTime?

  status            MaintenanceStatus

  createdAt         DateTime @default(now())

  updatedAt         DateTime @updatedAt

  sevenDayWarningSent Boolean @default(false)

  threeDayWarningSent Boolean @default(false)

  oneDayWarningSent Boolean @default(false)

  @@unique([agentId,cycleMonth,cycleYear])

  @@index([agentId])

  @@index([status])

  @@index([cycleMonth,cycleYear])

  @@index([status, cycleEndDate])

  @@map("agent_maintenance_cycles")
}

model AgentReactivationRequest {
  id String @id @default(uuid())

  agentId String
  agent   Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  submittedByUserId Int?
  submittedByUser   User? @relation(fields: [submittedByUserId],references: [id])

  submittedBranchCode String? 
  submittedBranch Branch? @relation(fields: [submittedBranchCode],references: [branchCode])

  requestType ReactivationType

  status ReactivationRequestStatus @default(PENDING)

  requiredSales  Int     @default(1)
  completedSales Int     @default(0)
  isCompleted    Boolean @default(false)

  requestedAt DateTime @default(now())
  approvedAt  DateTime?

  probationStartedAt DateTime?
  probationEndsAt    DateTime?

  completedAt DateTime?
  failedAt    DateTime?
  cancelledAt DateTime?

  cooldownUntil DateTime?

  reason  String?
  remarks String?

  approvals   AgentReactivationApproval[]
  attachments AgentReactivationAttachment[]
  payment     AgentReactivationPayment?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([agentId])
  @@index([agentId, status])
  @@index([agentId, createdAt])
  @@index([agentId, cooldownUntil])

  @@map("agent_reactivation_requests")
}

model AgentRecomForPromotion {
  id String @id @default(uuid())

  agentId String
  agent   Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  submittedByUserId Int?
  submittedByUser   User? @relation(fields: [submittedByUserId],references: [id])

  status RecoPromotionStatus @default(PENDING)

  remarks String?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
}


model AgentReactivationPayment {
  id String @id @default(uuid())

  requestId String @unique
  request   AgentReactivationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  agentId String
  agent   Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  amount   Decimal @db.Decimal(12, 2)
  currency String  @default("PHP")

  provider String @default("XENDIT")

  status ReactivationPaymentStatus @default(PENDING)

  checkoutUrl String?

  xenditPaymentSessionId String? @unique
  xenditReferenceId      String? @unique

  paidAt        DateTime?
  failedAt      DateTime?
  expiredAt     DateTime?
  cancelledAt   DateTime?

  rawResponse Json?
  rawWebhook  Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([agentId])
  @@index([requestId])
  @@index([status])
  @@index([xenditPaymentSessionId])
  @@index([xenditReferenceId])

  @@map("agent_reactivation_payments")
}

