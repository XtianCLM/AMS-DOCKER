{
  "extends": "../../tsconfig.base.json",

  "compilerOptions": {
    "types": ["node"],

    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2020",

    "rootDir": "./src",
    "outDir": "./dist",

    "strict": true
  },

  "include": [
    "src/**/*.ts"
  ],

  "exclude": [
    "node_modules",
    "dist",
    "factory",
    "prisma.config.ts"
  ]
}